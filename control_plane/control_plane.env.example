# ── File paths inside the container (must match the volume mounts
#    in the root docker-compose.yml) ──
IPXE_CP_AGENTS_FILE=/app/config/agents.yml
IPXE_CP_WORKERS_FILE=/app/state/workers.yml
IPXE_CP_DEVICES_FILE=/app/state/devices.yml
IPXE_CP_OPERATIONS_FILE=/app/state/operations.jsonl
IPXE_CP_SETTINGS_FILE=/app/state/settings.json
IPXE_CP_DNSMASQ_HOSTS_FILE=/app/dnsmasq/dhcp-hosts.conf
# NVMe-oF authentication key store (DHHC-1, indexed by worker_id).
# Same confidentiality level as the boot secrets: protect the volume.
IPXE_CP_CREDENTIALS_FILE=/app/state/credentials.yml

# ── TOFU boot-chain server certificate (self-signed, generated idempotently
#    at Control Plane startup; nginx mounts state/certs read-only) ──
IPXE_CP_CERT_DIR=/app/state/certs
IPXE_CP_CERT_SAN=IP:127.0.0.1,DNS:localhost
IPXE_CP_CERT_DAYS=3650

# ── dnsmasq integration ──
# Container name of the dnsmasq instance to reload after batch changes
IPXE_CP_DNSMASQ_CONTAINER=ipxe-dnsmasq
# Reload dnsmasq automatically after writes (requires docker.sock mount)
IPXE_CP_DNSMASQ_RELOAD=true

# ── Boot behavior ──
# Default iPXE architecture when the client does not advertise one
IPXE_CP_DEFAULT_ARCH=x86_64
# iPXE boot menu timeout in milliseconds
IPXE_CP_BOOT_MENU_TIMEOUT=5000
# Timeout in seconds for calls to storage Agents
IPXE_CP_AGENT_TIMEOUT=10

# Auto-register new workers: when an unbound MAC requests /boot-vars,
# Control Plane registers it with an auto-assigned hostname (worker-00, ...)
# and returns menu-default=reboot until a disk/default OS is configured.
IPXE_CP_AUTO_REGISTER=true
# Reboot-loop menu timeout (seconds) for workers without a default boot item.
IPXE_CP_AUTO_BOOT_TIMEOUT=1

# Container timezone for log timestamps (requires tzdata in image)
# Change this to your local timezone, e.g. Asia/Shanghai, UTC, America/New_York
TZ=Asia/Shanghai

# Optional. If set, all endpoints except /healthz require:
# Authorization: Bearer <IPXE_CP_TOKEN>
IPXE_CP_TOKEN=

# Example Agent tokens referenced by config/agents.yml.example.
STORAGE_LIO_01_TOKEN=replace-me
CONTROLLER_STGT_TOKEN=replace-me
