IPXE_CP_AGENTS_FILE=/app/config/agents.yml
IPXE_CP_WORKERS_FILE=/app/state/workers.yml
IPXE_CP_OPERATIONS_FILE=/app/state/operations.jsonl
IPXE_CP_DNSMASQ_HOSTS_FILE=/app/dnsmasq/dhcp-hosts.conf
IPXE_CP_DNSMASQ_CONTAINER=ipxe-dnsmasq
IPXE_CP_DNSMASQ_RELOAD=true
IPXE_CP_DEFAULT_ARCH=x86_64
IPXE_CP_BOOT_MENU_TIMEOUT=5000
IPXE_CP_AGENT_TIMEOUT=10

# Optional. If set, all endpoints except /healthz require:
# Authorization: Bearer <IPXE_CP_TOKEN>
IPXE_CP_TOKEN=
