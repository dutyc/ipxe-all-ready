# 存储节点注册表模板（部署时复制为 agents.yml，该文件已被 .gitignore 忽略）。
# 每个节点一段，字段说明：
#   base_url    该节点 Agent 的 HTTP 地址（从控制面容器可达，容器内用 host.docker.internal）
#   storager_ip  数据面地址：Worker 挂盘时写入 /boot-vars 的 root-path，须为 Worker 可达的 IP
#   token       该节点 .env 的 KURRENT_AGENT_TOKEN；支持 ${ENV} 占位，如 ${STORAGE_LIO_01_TOKEN}
#   role.disk   是否可挂系统盘；role.cd 是否可挂 ISO（安装镜像）
#   tags        自定义标签（存储类型/后端等），Web 界面可按标签筛选
#   enabled     启用后才参与调度
agents:
  storage-lio-01:
    base_url: http://host.docker.internal:4840
    storager_ip: 192.168.1.5
    token: ${STORAGE_LIO_01_TOKEN}
    role:
      disk: true
      cd: false
    tags:
      - storage
      - lio
    enabled: true

  controller-stgt:
    base_url: http://host.docker.internal:4840
    storager_ip: 192.168.1.5
    token: ${CONTROLLER_STGT_TOKEN}
    role:
      disk: false
      cd: true
    tags:
      - controller
      - stgt
      - iso
    enabled: true
