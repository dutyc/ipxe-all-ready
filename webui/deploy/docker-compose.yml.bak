# Build: docker compose up -d --build
# Requires: Control Plane (:4839) running on host
#   Or set CONTROL_PLANE_URL env var to point to remote
# Access: Web UI → http://localhost:4838
#         Files browse  → http://localhost:4838/browse/
#         Files  → http://localhost:4838/file/

services:
  nginx:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: cp-webui
    ports:
      - "4838:80"
    volumes:
      # ── Web UI 静态文件 (cd app && npm run build) ──
      - ../app/dist:/usr/share/nginx/html:ro
      # ── 文件浏览器页面 (浏览工具的 HTML/JS 本身) ──
      - ./www/browse:/usr/share/nginx/browse:ro
      # ── iPXE 公开文件目录: ISO, kernel, initrd (被浏览和下载的数据) ──
      - ${PUBLIC_PATH:-./public}:/data:ro
    extra_hosts:
      - "host.docker.internal:host-gateway"
    restart: unless-stopped
