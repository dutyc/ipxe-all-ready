# Storager node configuration template (shared Agent + backends).
# Copy to .env and adjust values before running:
#   NVMe-oF (preferred): cd storager/nvmeof && docker compose --env-file ../.env up -d
#   iSCSI (fallback)   : cd storager/iscsi   && docker compose --env-file ../.env up -d
#
# Architecture rule (2026-08-22): NVMe-oF is the primary and only data-plane
# storage protocol; iSCSI is kept only as a transitional fallback option
# (the Windows ecosystem's NVMe-oF support is still incomplete).

# Backend: "nvmet" (NVMe-oF, preferred/default), "stgt" or "lio" (iSCSI fallback)
KURRENT_BACKEND=nvmet

# Directory where disk images (.img) and ISO files live.
# Must match the volume mount in docker-compose.yml.
KURRENT_DISK_DIR=/home/iscsi_img

# Disk identifier namespace base (authoritative = NQN, NVMe-oF preferred):
# the IQN used by the iSCSI data plane is derived from it ("iqn." + nqn[4:]),
# never the other way round (NQN must not be defined from an IQN).
# Must match the base used by iPXE boot scripts.
KURRENT_NQN_BASE=nqn.2026-07.com.kurrent

# Agent operation log (JSONL). Must match the volume mount in docker-compose.yml.
KURRENT_LOG_FILE=/var/log/ipxe-agent/ops.jsonl

# ── NVMe-oF (KURRENT_BACKEND=nvmet, preferred) ──
# nvmet host service runs as a compose container (kurrent-nvmet-host);
# this URL is the compose-internal service name (not reachable from the LAN).
KURRENT_NVMET_HOST_URL=https://host.docker.internal:4841
# Credential cache (DHHC-1 plaintext, mode 0600). Must match the volume mount.
KURRENT_NVMET_CACHE_FILE=/var/log/ipxe-agent/nvmet-credentials.json

# ── Component PKI (K8S-style, 2026-08-31) ──
# Component identity: must match the key in control_plane/config/agents.yml
KURRENT_AGENT_ID=storage-lio-01
KURRENT_COMPONENT=agent
# Certificate directory inside the container (persisted via volume mount)
KURRENT_PKI_DIR=/etc/ipxe-agent/pki
# Control-plane nginx entry for enroll/renew (TLS, TOFU trust via KURRENT_CP_CA)
KURRENT_CP_ENROLL_URL=https://host.docker.internal
KURRENT_CP_CA=/etc/ipxe-agent/cp-ca.crt
# One-time bootstrap token for first enrollment (burned after use; remove after
# first successful enroll - renewal uses the client cert itself)
KURRENT_BOOTSTRAP_TOKEN=replace-me
# Control-plane-reachable address of this node, reported in the enroll request;
# the control plane writes it to agents.yml on first auto-registration.
# kurrent-join.sh derives it automatically (https://<cp-host>:4840) - set only
# when the default is wrong (e.g. node behind NAT).
KURRENT_ADVERTISE_URL=
# Host-side PKI mount paths (compose interpolation). kurrent-join.sh writes
# absolute paths keyed by agent id, e.g. ../../control_plane/state/pki/components/
# agent-storage-01 (same directory the control plane issues certificates into).
# KURRENT_AGENT_PKI_HOST=/path/to/agent-pki
# KURRENT_NVMET_PKI_HOST=/path/to/nvmet-pki

# One-command join (kubeadm-style):
#   kurrent join <cp-url> <bootstrap-token> <agent-id> [--nvmet-token T]
# It upserts the keys above into .env, then runs compose up -d.
# (Equivalent bash fallback without Go: ./kurrent-join.sh with same args)

# ── iSCSI (KURRENT_BACKEND=stgt|lio, fallback only) ──
# Name of the local iSCSI server container the Agent drives via docker.sock.
# Required only by the iSCSI backends; the nvmet backend is driven over HTTP
# (no docker.sock container dispatch), so this variable is unused with nvmet.
KURRENT_ISCSI_CONTAINER=storager-iscsi

# Container timezone for log timestamps (requires tzdata in image)
# Change this to your local timezone, e.g. Asia/Shanghai, UTC, America/New_York
TZ=Asia/Shanghai
