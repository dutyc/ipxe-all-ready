services:
  ipxe-lio:
    build:
      context: ./lio
      dockerfile: Dockerfile
    image: ipxe-lio
    container_name: ipxe-lio
    restart: unless-stopped
    network_mode: host
    privileged: true
    volumes:
      - /sys/kernel/config:/sys/kernel/config
      - /lib/modules:/lib/modules:ro
      - /pool1/iscsi_img:/home/iscsi_img
      - ./etc/target:/etc/rtslib-fb-target  
    command:
      - sh
      - -c
      - |
        mkdir -p /run/dbus
        dbus-uuidgen --ensure || true      # 补 machine-id，缺它 dbus-daemon 起不来
        dbus-daemon --system --fork        # 先起总线，targetclid 要往这注册
        targetclid                         # 再起管理守护；前台或后台都不影响下面
        sleep infinity                     # 兜底占住前台，保证容器不退（targetclid 若前台则这行轮不到，无害）
